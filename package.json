{
  "name": "scene-video-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "文字を入力するだけでアニメーション付きの解説動画を作る、シーン式のローカル Web アプリ",
  "scripts": {
    "dev": "vite",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "tsx scripts/render.ts",
    "stills": "tsx scripts/stills.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.1",
    "@remotion/bundler": "4.0.543",
    "@remotion/cli": "4.0.543",
    "@remotion/player": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "zod": "4.6.7"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
